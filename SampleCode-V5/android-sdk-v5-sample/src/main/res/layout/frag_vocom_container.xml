<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_camera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        android:name="com.kcg.dr.camera.CameraFeedFragment"

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_status"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        android:name="com.kcg.dr.flight.StatusFragment"

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_waypoints"
        android:layout_width="250dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_status" />
        android:name="com.kcg.dr.waypoints.WaypointsFragment"

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_virtual_sticks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/container_waypoints"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_status" />
        android:name="com.kcg.dr.flight.VirtualStickControlsFragment"

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_voice"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/container_waypoints"
        app:layout_constraintStart_toStartOf="parent" />
        android:name="com.kcg.dr.voice.VoiceControlFragment"

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_demo"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/container_voice"
        app:layout_constraintStart_toStartOf="parent" />
        android:name="com.kcg.dr.demo.DemoFragment"

</androidx.constraintlayout.widget.ConstraintLayout>
