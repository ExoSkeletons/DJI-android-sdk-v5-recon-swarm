<?xml version="1.0" encoding="utf-8"?>


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_server_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_media_stop"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tv_server_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="API Server: Stopped"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:minWidth="60dp"
                app:thumbTint="@android:color/white" />

        </LinearLayout>

    <TextView
        android:id="@+id/tv_tunneling_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <TextView
            android:id="@+id/tv_logs"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:text="Waiting for requests..."
            android:textColor="#A0FFFFFF"
            android:textSize="9sp"
            tools:text="GET /status\nPOST /key\nGET /fly" />

    </LinearLayout>